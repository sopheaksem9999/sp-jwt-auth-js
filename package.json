{
  "name": "@sokpheak/sp-jwt-auth",
  "version": "0.1.0",
  "description": "Typed JavaScript client for the sopheak/sp-jwt-auth Laravel package: token storage, refresh and session helpers.",
  "license": "MIT",
  "author": "Sem Sopheak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sopheaksem9999/sp-jwt-auth-js.git"
  },
  "homepage": "https://github.com/sopheaksem9999/sp-jwt-auth-js#readme",
  "bugs": {
    "url": "https://github.com/sopheaksem9999/sp-jwt-auth-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "verify": [
        "./dist/verify.d.ts"
      ],
      "otp": [
        "./dist/otp.d.ts"
      ],
      "mfa": [
        "./dist/mfa.d.ts"
      ],
      "oauth": [
        "./dist/oauth.d.ts"
      ],
      "sessions": [
        "./dist/sessions.d.ts"
      ],
      "account": [
        "./dist/account.d.ts"
      ],
      "social": [
        "./dist/social.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./verify": {
      "import": {
        "types": "./dist/verify.d.ts",
        "default": "./dist/verify.js"
      },
      "require": {
        "types": "./dist/verify.d.cts",
        "default": "./dist/verify.cjs"
      }
    },
    "./otp": {
      "import": {
        "types": "./dist/otp.d.ts",
        "default": "./dist/otp.js"
      },
      "require": {
        "types": "./dist/otp.d.cts",
        "default": "./dist/otp.cjs"
      }
    },
    "./mfa": {
      "import": {
        "types": "./dist/mfa.d.ts",
        "default": "./dist/mfa.js"
      },
      "require": {
        "types": "./dist/mfa.d.cts",
        "default": "./dist/mfa.cjs"
      }
    },
    "./oauth": {
      "import": {
        "types": "./dist/oauth.d.ts",
        "default": "./dist/oauth.js"
      },
      "require": {
        "types": "./dist/oauth.d.cts",
        "default": "./dist/oauth.cjs"
      }
    },
    "./sessions": {
      "import": {
        "types": "./dist/sessions.d.ts",
        "default": "./dist/sessions.js"
      },
      "require": {
        "types": "./dist/sessions.d.cts",
        "default": "./dist/sessions.cjs"
      }
    },
    "./account": {
      "import": {
        "types": "./dist/account.d.ts",
        "default": "./dist/account.js"
      },
      "require": {
        "types": "./dist/account.d.cts",
        "default": "./dist/account.cjs"
      }
    },
    "./social": {
      "import": {
        "types": "./dist/social.d.ts",
        "default": "./dist/social.js"
      },
      "require": {
        "types": "./dist/social.d.cts",
        "default": "./dist/social.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:edge-canary": "vitest run --project edge test/edge-canary.test.ts",
    "test:deno": "deno run -A node_modules/vitest/vitest.mjs run --project node",
    "test:bun": "bun --bun node_modules/vitest/vitest.mjs run --project node",
    "check": "pnpm build && publint && attw --pack . && node scripts/check-dist.mjs && node scripts/check-modules.mjs && node scripts/check-bundle.mjs && node scripts/smoke-imports.mjs && node scripts/check-neutral-names.mjs",
    "smoke:deno": "deno run --allow-read scripts/deno-smoke.ts",
    "smoke:bun": "bun run scripts/deno-smoke.ts",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "jose": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "jose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "jose": "6.2.12",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
